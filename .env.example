# ---------------------------------------------------------------------------
# Environment configuration for ONE instance of the RTSP camera backend.
#
# Copy to `.env` and edit. Every RTSP_* variable overrides the matching value
# in config.yaml. Real environment variables always take precedence over this
# file, so `.env` holds this instance's defaults.
#
# Run several independent instances side by side by giving each its own env
# file and pointing RTSP_ENV_FILE at it, e.g.:
#     RTSP_ENV_FILE=instance-a.env python run.py
#     RTSP_ENV_FILE=instance-b.env python run.py
# Give each a distinct RTSP_PORT (and usually its own RTSP_CONFIG) so they do
# not collide with each other or with your other service.
# ---------------------------------------------------------------------------

# Which YAML config file to load. Cameras (with their RTSP URLs) are declared there.
RTSP_CONFIG=config.yaml

# Network binding for THIS instance. Use a distinct port per instance.
RTSP_HOST=0.0.0.0
RTSP_PORT=8000

# The camera that /snapshot and /stream serve by default.
# Switchable at runtime via:  POST /active-camera  {"id": "..."}
RTSP_ACTIVE_CAMERA=front_door

# Seconds between WebSocket "stats" telemetry events.
RTSP_STATS_INTERVAL=5.0

# ---------------------------------------------------------------------------
# Security / production hardening (all optional; safe defaults for dev).
# ---------------------------------------------------------------------------

# Optional API key. When set, every /api and control request must present it in
# the `X-API-Key` header (or `?api_key=`); /health and the dashboard stay open.
# Leave unset for an open (trusted LAN / behind-auth-proxy) deployment.
# RTSP_API_KEY=change-me

# Allow selecting the InsightFace backend to auto `pip install insightface`.
# Off by default so a public endpoint cannot mutate the host Python env.
# RTSP_ALLOW_AUTO_INSTALL=0

# Max size (bytes) for a single uploaded file (datasets / reference / panel /
# inspection). Default 512 MiB.
# RTSP_MAX_UPLOAD_BYTES=536870912
